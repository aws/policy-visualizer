{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::example-bucket", "arn:aws:s3:::example-bucket/*"],
      "Condition": {
        "StringEquals": { "s3:prefix": "reports/" }
      }
    },
    {
      "Sid": "DynamoReadWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-1:111122223333:table/example-table"
    },
    {
      "Sid": "BlockDangerous",
      "Effect": "Deny",
      "Action": ["iam:CreateUser", "iam:DeleteRole"],
      "Resource": "*"
    }
  ]
}
